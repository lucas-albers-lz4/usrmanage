#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Lucas Albers <lucas.b.albers@gmail.com>
#
# usrmanage — local UNIX user management for OpenWrt

set -e

LIB=
for _p in \
	"/usr/lib/usrmanage/usrmanage-lib.sh" \
	"$(dirname "$0")/../lib/usrmanage/usrmanage-lib.sh"
do
	if [ -f "$_p" ]; then
		LIB=$_p
		break
	fi
done

if [ -z "$LIB" ]; then
	_here=$(cd "$(dirname "$0")" && pwd)
	# Package source tree: .../files/usr/sbin → .../files/usr/lib/usrmanage
	if [ -f "$_here/../lib/usrmanage/usrmanage-lib.sh" ]; then
		LIB="$_here/../lib/usrmanage/usrmanage-lib.sh"
	fi
fi

if [ -z "$LIB" ] || [ ! -f "$LIB" ]; then
	echo "error: usrmanage-lib.sh not found" >&2
	exit 1
fi

USRMANAGE_LIB_DIR=$(cd "$(dirname "$LIB")" && pwd)
export USRMANAGE_LIB_DIR

# shellcheck disable=SC1090
. "$LIB"

usage() {
	cat <<'EOF'
Usage: usrmanage <command> [options]

View:
  list [--json] [--all]
  show <user> [--json]
  audit [--json] [--last N]
  doctor [--json]
  policy [--json] [--full]

Manage (root):
  add <user> --role readonly|admin [--luci-login] [--password-fd N] [--json]
  set-role <user> --role readonly|admin [--json]
  set-luci-login <user> --enable|--disable|--reset [--json]
  passwd <user> [--password-fd N] [--json]
  del <user> [--purge-home] [--json]
  set-policy --preset openwrt|standard|strict|custom [options] [--json]

Environment:
  USRMANAGE_ACTOR   Override audit actor (LuCI sets this)
  USRMANAGE_SRC     cli|luci (default cli)
EOF
}

JSON_OUT=0
CMD=
PASS_FD=
ROLE=
PURGE=0
LUCI_LOGIN=0
LUCI_LOGIN_MODE=
NAME=
LAST=50
ALL=0
POS1=
POS2=
POLICY_FULL=0
SET_PRESET=
SET_MIN=
SET_REJ=
SET_LOW=
SET_UP=
SET_DIG=
SET_SPE=

um_require_numeric() {
	# um_require_numeric <value> <die_message>
	case "$1" in
		''|*[!0-9]*) um_die "$2" ;;
	esac
}

[ "$#" -ge 1 ] || { usage; exit 1; }
CMD=$1
shift

case "$CMD" in
	-h|--help|help)
		usage
		exit 0
		;;
esac

while [ "$#" -gt 0 ]; do
	case "$1" in
		--json)
			JSON_OUT=1
			export JSON_OUT
			shift
			;;
		--all)
			ALL=1
			shift
			;;
		--purge-home)
			PURGE=1
			shift
			;;
		--luci-login)
			LUCI_LOGIN=1
			shift
			;;
		--enable)
			LUCI_LOGIN_MODE=enable
			shift
			;;
		--disable)
			LUCI_LOGIN_MODE=disable
			shift
			;;
		--reset)
			LUCI_LOGIN_MODE=reset
			shift
			;;
		--password-fd)
			[ "$#" -ge 2 ] || um_die "error: --password-fd needs a number"
			um_require_numeric "$2" "error: --password-fd needs a number"
			PASS_FD=$2
			shift 2
			;;
		--role)
			[ "$#" -ge 2 ] || um_die "error: --role needs readonly|admin"
			ROLE=$2
			shift 2
			;;
		--last)
			[ "$#" -ge 2 ] || um_die "error: --last needs a number"
			um_require_numeric "$2" "error: --last needs a number"
			LAST=$2
			shift 2
			;;
		--full)
			POLICY_FULL=1
			shift
			;;
		--preset)
			[ "$#" -ge 2 ] || um_die "error: --preset needs a value"
			SET_PRESET=$2
			shift 2
			;;
		--min-length)
			[ "$#" -ge 2 ] || um_die "error: --min-length needs a value"
			SET_MIN=$2
			shift 2
			;;
		--reject-username)
			[ "$#" -ge 2 ] || um_die "error: --reject-username needs 0|1"
			SET_REJ=$2
			shift 2
			;;
		--require-lower)
			[ "$#" -ge 2 ] || um_die "error: --require-lower needs 0|1"
			SET_LOW=$2
			shift 2
			;;
		--require-upper)
			[ "$#" -ge 2 ] || um_die "error: --require-upper needs 0|1"
			SET_UP=$2
			shift 2
			;;
		--require-digit)
			[ "$#" -ge 2 ] || um_die "error: --require-digit needs 0|1"
			SET_DIG=$2
			shift 2
			;;
		--require-special)
			[ "$#" -ge 2 ] || um_die "error: --require-special needs 0|1"
			SET_SPE=$2
			shift 2
			;;
		--actor)
			[ "$#" -ge 2 ] || um_die "error: --actor needs a value"
			USRMANAGE_ACTOR=$2
			export USRMANAGE_ACTOR
			# Validated at audit time via um_actor_resolve whitelist
			shift 2
			;;
		--src)
			[ "$#" -ge 2 ] || um_die "error: --src needs cli|luci"
			case "$2" in
				cli|luci) USRMANAGE_SRC=$2 ;;
				*) um_die "error: --src needs cli|luci" ;;
			esac
			export USRMANAGE_SRC
			shift 2
			;;
		-*)
			um_die "error: unknown option: $1"
			;;
		*)
			if [ -z "$POS1" ]; then
				POS1=$1
			elif [ -z "$POS2" ]; then
				POS2=$1
			else
				um_die "error: unexpected argument: $1"
			fi
			shift
			;;
	esac
done

NAME=$POS1
export JSON_OUT

case "$CMD" in
	list)
		_list_args=
		[ "$JSON_OUT" = "1" ] && _list_args="$_list_args --json"
		[ "$ALL" = "1" ] && _list_args="$_list_args --all"
		# shellcheck disable=SC2086
		um_cmd_list $_list_args
		;;
	show)
		[ -n "$NAME" ] || um_die "usage: usrmanage show <user> [--json]"
		if [ "$JSON_OUT" = "1" ]; then
			um_cmd_show --json "$NAME"
		else
			um_cmd_show "$NAME"
		fi
		;;
	audit)
		if [ "$JSON_OUT" = "1" ]; then
			um_cmd_audit --json --last "$LAST"
		else
			um_cmd_audit --last "$LAST"
		fi
		;;
	doctor)
		if [ "$JSON_OUT" = "1" ]; then
			um_doctor_checks --json || true
		else
			um_doctor_checks || true
		fi
		;;
	policy)
		if [ "$JSON_OUT" = "1" ]; then
			if [ "$POLICY_FULL" = "1" ]; then
				um_policy_json_full
			else
				um_policy_json_name
			fi
		else
			um_policy_load
			printf 'preset=%s label=%s min_length=%s\n' \
				"$UM_POL_PRESET" "$(um_policy_label "$UM_POL_PRESET")" "$UM_POL_MIN_LENGTH"
		fi
		;;
	set-policy)
		um_require_root
		[ -n "$SET_PRESET" ] || um_die "usage: usrmanage set-policy --preset openwrt|standard|strict|custom ..."
		if [ "$SET_PRESET" = "custom" ]; then
			um_policy_set_fields custom "$SET_MIN" "$SET_REJ" "$SET_LOW" "$SET_UP" "$SET_DIG" "$SET_SPE" \
				|| um_die "error: invalid_policy"
		else
			um_policy_set_fields "$SET_PRESET" || um_die "error: invalid_policy"
		fi
		um_with_lock um_policy_save || um_die "error: policy_save_failed"
		if [ "$JSON_OUT" = "1" ]; then
			um_policy_json_full
		else
			printf 'ok: policy preset=%s\n' "$UM_POL_PRESET"
		fi
		;;
	add)
		um_require_root
		[ -n "$NAME" ] || um_die "usage: usrmanage add <user> --role readonly|admin [--luci-login]"
		[ -n "$ROLE" ] || um_die "usage: usrmanage add <user> --role readonly|admin [--luci-login]"
		um_with_lock um_mut_add "$NAME" "$ROLE" "$PASS_FD" "$LUCI_LOGIN"
		;;
	set-role)
		um_require_root
		[ -n "$NAME" ] || um_die "usage: usrmanage set-role <user> --role readonly|admin"
		[ -n "$ROLE" ] || um_die "usage: usrmanage set-role <user> --role readonly|admin"
		um_with_lock um_mut_set_role "$NAME" "$ROLE"
		;;
	set-luci-login)
		um_require_root
		[ -n "$NAME" ] || um_die "usage: usrmanage set-luci-login <user> --enable|--disable|--reset"
		[ -n "$LUCI_LOGIN_MODE" ] || um_die "usage: usrmanage set-luci-login <user> --enable|--disable|--reset"
		um_with_lock um_mut_set_luci_login "$NAME" "$LUCI_LOGIN_MODE"
		;;
	passwd)
		um_require_root
		[ -n "$NAME" ] || um_die "usage: usrmanage passwd <user>"
		um_with_lock um_mut_passwd "$NAME" "$PASS_FD"
		;;
	del|delete|remove)
		um_require_root
		[ -n "$NAME" ] || um_die "usage: usrmanage del <user> [--purge-home]"
		um_with_lock um_mut_del "$NAME" "$PURGE"
		;;
	*)
		usage
		exit 1
		;;
esac
