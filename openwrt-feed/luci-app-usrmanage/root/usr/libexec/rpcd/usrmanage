#
# rpcd plugin: ubus object "usrmanage"
# Passwords are never accepted as ubus JSON string args for mutation methods
# that set credentials — use the "password" field which is read and passed
# to the CLI on stdin / password-fd only within this root process, never logged.

USRMANAGE_BIN="${USRMANAGE_BIN:-/usr/sbin/usrmanage}"

read_input() {
	INPUT=
	if [ -n "$3" ]; then
		INPUT=$3
	else
		INPUT=$(cat)
	fi
}

json_get() {
	_key=$1
	printf '%s' "$INPUT" | jsonfilter -e "@.${_key}" 2>/dev/null
}

json_get_bool() {
	_key=$1
	_v=$(json_get "$_key")
	case "$_v" in
		true|1|yes) printf '1' ;;
		*) printf '0' ;;
	esac
}

json_get_num() {
	_key=$1
	_v=$(json_get "$_key")
	printf '%s' "$_v"
}

sanitize_actor() {
	_raw=$1
	case "$_raw" in
		''|*[!A-Za-z0-9._@-]*)
			printf '%s' "unknown"
			return 0
			;;
	esac
	_alen=${#_raw}
	if [ "$_alen" -lt 1 ] || [ "$_alen" -gt 64 ]; then
		printf '%s' "unknown"
		return 0
	fi
	printf '%s' "$_raw"
}

session_actor() {
	if [ -n "${USRMANAGE_ACTOR:-}" ]; then
		sanitize_actor "$USRMANAGE_ACTOR"
		return 0
	fi
	if [ -n "${RPC_SESSION_USERNAME:-}" ]; then
		sanitize_actor "$RPC_SESSION_USERNAME"
		return 0
	fi
	if [ -n "${RPC_SESSION:-}" ] && command -v ubus >/dev/null 2>&1; then
		_u=$(ubus call session get "{\"ubus_rpc_session\":\"${RPC_SESSION}\"}" 2>/dev/null \
			| jsonfilter -e '@.values.username' 2>/dev/null) || _u=
		if [ -n "$_u" ]; then
			sanitize_actor "$_u"
			return 0
		fi
	fi
	printf '%s' "unknown"
}

run_cli() {
	# Explicit argv only — never unquoted $* (Zen MCR C2).
	_actor=$(session_actor)
	USRMANAGE_SRC=luci USRMANAGE_ACTOR="$_actor" "$USRMANAGE_BIN" "$@"
}

run_manage_password() {
	_name=$1
	_role=$2
	_pass=$(json_get password)
	_actor=$(session_actor)
	if [ -z "$_pass" ]; then
		printf '{"ok":false,"error":"password_required"}\n'
		return 0
	fi
	printf '%s\n' "$_pass" | USRMANAGE_SRC=luci USRMANAGE_ACTOR="$_actor" \
		"$USRMANAGE_BIN" add "$_name" --role "$_role" --password-fd 0 --json
	_pass=
}

run_passwd() {
	_name=$1
	_pass=$(json_get password)
	_actor=$(session_actor)
	if [ -z "$_pass" ]; then
		printf '{"ok":false,"error":"password_required"}\n'
		return 0
	fi
	printf '%s\n' "$_pass" | USRMANAGE_SRC=luci USRMANAGE_ACTOR="$_actor" \
		"$USRMANAGE_BIN" passwd "$_name" --password-fd 0 --json
	_pass=
}

run_set_policy() {
	_preset=$(json_get preset)
	_min=$(json_get_num min_length)
	_rej=$(json_get_bool reject_username)
	_low=$(json_get_bool require_lower)
	_up=$(json_get_bool require_upper)
	_dig=$(json_get_bool require_digit)
	_spe=$(json_get_bool require_special)
	case "$_preset" in
		openwrt|standard|strict)
			run_cli set-policy --preset "$_preset" --json
			;;
		custom)
			run_cli set-policy --preset custom \
				--min-length "$_min" \
				--reject-username "$_rej" \
				--require-lower "$_low" \
				--require-upper "$_up" \
				--require-digit "$_dig" \
				--require-special "$_spe" \
				--json
			;;
		*)
			printf '{"ok":false,"error":"invalid_preset"}\n'
			;;
	esac
}

case "$1" in
	list)
		echo '{'
		echo '  "list": { "all": false },'
		echo '  "show": { "name": "" },'
		echo '  "audit": { "last": 50 },'
		echo '  "doctor": {},'
		echo '  "policy": {},'
		echo '  "get_policy": {},'
		echo '  "set_policy": { "preset": "", "min_length": 8, "reject_username": true, "require_lower": false, "require_upper": false, "require_digit": false, "require_special": false },'
		echo '  "add": { "name": "", "role": "", "password": "" },'
		echo '  "del": { "name": "", "purge_home": false },'
		echo '  "set_role": { "name": "", "role": "" },'
		echo '  "passwd": { "name": "", "password": "" }'
		echo '}'
		;;
	call)
		METHOD=$2
		command -v jsonfilter >/dev/null 2>&1 || {
			printf '{"ok":false,"error":"jsonfilter_required"}\n'
			exit 1
		}
		read_input "$@"
		case "$METHOD" in
			list)
				_all=$(json_get_bool all)
				if [ "$_all" = "1" ]; then
					run_cli list --json --all
				else
					run_cli list --json
				fi
				;;
			show)
				_name=$(json_get name)
				run_cli show "$_name" --json
				;;
			audit)
				_last=$(json_get last)
				case "$_last" in
					''|*[!0-9]*) _last=50 ;;
				esac
				run_cli audit --json --last "$_last"
				;;
			doctor)
				run_cli doctor --json
				;;
			policy)
				run_cli policy --json
				;;
			get_policy)
				run_cli policy --json --full
				;;
			set_policy)
				run_set_policy
				;;
			add)
				_name=$(json_get name)
				_role=$(json_get role)
				run_manage_password "$_name" "$_role"
				;;
			del)
				_name=$(json_get name)
				_purge=$(json_get_bool purge_home)
				if [ "$_purge" = "1" ]; then
					run_cli del "$_name" --purge-home --json
				else
					run_cli del "$_name" --json
				fi
				;;
			set_role)
				_name=$(json_get name)
				_role=$(json_get role)
				run_cli set-role "$_name" "$_role" --json
				;;
			passwd)
				_name=$(json_get name)
				run_passwd "$_name"
				;;
			*)
				printf '{"error":"Method not found"}\n'
				exit 1
				;;
		esac
		;;
esac
